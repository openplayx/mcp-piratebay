{
  "schema_version": 1,
  "server": {
    "host": "0.0.0.0",
    "port": 8790,
    "docs_public": true,
    "log_level": "INFO"
  },
  "source": {
    "id": "tpb",
    "name": "The Pirate Bay (mirror)",
    "base_url": "https://thepiratebay10.info",
    "allowed_hosts": [],
    "allow_private_addresses": false,
    "allow_http": false,
    "proxy_ref": null,
    "timeout_seconds": 10,
    "max_concurrency": 2,
    "min_interval_ms": 500,
    "max_response_bytes": 4194304
  },
